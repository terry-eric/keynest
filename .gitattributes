# Keep embedded text predictable and preserve locked manifest hashes.
* text=auto eol=lf
*.lock -text
# Generated lock files retain CRLF; build logs retain tool-emitted spacing.
*.lock whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.log -whitespace
*.bin binary
*.elf binary
*.png binary
